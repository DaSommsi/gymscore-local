# ==========================================
# GymScore Local — .gitignore
# ==========================================

# Dependencies
node_modules/
package-lock.json
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Production build outputs
dist/
dist-electron/
release/
build/
out/
*.tsbuildinfo

# Electron packaging executables
*.exe
*.dmg
*.AppImage
*.deb
*.rpm
*.zip
*.tar.gz

# Local SQLite databases & temporary WAL files (keep templates tracked)
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db-journal
*.sqlite
*.sqlite3
!data/templates/
!data/templates/**

# Environment variables & secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# IDE & Editor configuration
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Testing & Coverage
coverage/
.nyc_output/
*.lcov
